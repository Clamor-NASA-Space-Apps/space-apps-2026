{"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"MAY_INCLUDE_COPYRIGHT_MATERIAL","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20180001979,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"f690aee4814d48c490070d4a174ff2a7","belongsToAuthors":false},"subjectCategories":["Life Sciences (General)","Man/System Technology And Life Support"],"exportControl":{"isExportControl":"NO","submissionId":20180001979,"ear":"NO","id":"2793a39268824739bbf1f075ad46471a","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["KSC-E-DAA-TN52878","Report Number: KSC-E-DAA-TN52878"],"title":"NASA's Interests in Bioregenerative Life Support","stiType":"PRESENTATION","distribution":"PUBLIC","submittedDate":"2018-03-20T10:58:11.2200000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20180001979,"meta":{"author":{"name":"Wheeler, Raymond M."},"organization":{"name":"NASA Kennedy Space Center","location":"Cocoa Beach, FL, United States"}},"id":"86e85eeb30924109ad505456b2503904"}],"stiTypeDetails":"Presentation","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20180001979,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2018-03-20T10:58:11.2200000+00:00","center":{"code":"KSC","name":"Kennedy Space Center","id":"a74d241e0e974719b03cb45cbace6b20"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"NASA and other space agencies and around the world have had long-standing interest in using plants and biological approaches for regenerative life support. In particular, NASA's Kennedy Space Center, has conducted research in this area for over 30 years. One unique aspect to this testing was NASA's Biomass Production Chamber, which had four vertically stacked growing shelves inside a large, 113 cubic meter chamber. This was perhaps one of the first working examples of a vertical agriculture system in the world. A review of some of this research along with some of the more salient findings will be presented.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"Canada","submissionId":20180001979,"sponsors":[{"organizationId":"40dccfa311074a0f9fc5c5bd3b20cadc","meta":{"organization":{"name":"Guelph Univ.","location":"Ontario, Canada"}},"meetingId":"0dd21fe59ffa45f8b3ff14cc925da4ec","id":"46a0347a7884415e98c085c42113497e"}],"name":"Department Seminar, University of Guelph","location":"Guelph, ON","id":"0dd21fe59ffa45f8b3ff14cc925da4ec","startDate":"2018-03-16T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20180001979,"id":"4b26ac76298a41f789684332b3dd3c50","publicationDate":"2018-03-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20180001979.pdf","type":"STI","links":{"original":"/api/citations/20180001979/downloads/20180001979.pdf","pdf":"/api/citations/20180001979/downloads/20180001979.pdf","fulltext":"/api/citations/20180001979/downloads/20180001979.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-05-06-21"}